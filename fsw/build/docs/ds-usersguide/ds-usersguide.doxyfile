# Allow overrides
@INCLUDE_PATH          = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw

# Common setup
@INCLUDE               = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/build/docs/ds-common.doxyfile

# OSAL and cfe to resolve references and provide default settings
@INCLUDE               = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/build/docs/cfe-common.doxyfile
