#---------------------------------------------------------------------------
# OSAL common setup for including in stand alone or mission documentation
#---------------------------------------------------------------------------

# Allow overrides
@INCLUDE_PATH          = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw

# Default settings
@INCLUDE               = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/osal/docs/src/default-settings.doxyfile

# Minimum set of source files (includes *.dox, followed by public headers)
INPUT                 +=  \
  /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/osal/docs/src/osal_frontpage.dox \
  /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/osal/docs/src/osal_fs.dox \
  /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/osal/docs/src/osal_timer.dox

# Public header list is generated from the interface includes of the osal_public_api target
@INCLUDE               = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/build/docs/osal-public-api.doxyfile

# Strip source dir from path
STRIP_FROM_PATH       += /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw
