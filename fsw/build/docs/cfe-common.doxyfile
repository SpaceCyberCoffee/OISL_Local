# Exclude repo documentation
EXCLUDE_PATTERNS       += "*/CHANGELOG.md"
EXCLUDE_PATTERNS       += "*/CODE_OF_CONDUCT.md"
EXCLUDE_PATTERNS       += "*/CONTRIBUTING.md"
EXCLUDE_PATTERNS       += "*/README.md"
EXCLUDE_PATTERNS       += "*/SECURITY.md"
