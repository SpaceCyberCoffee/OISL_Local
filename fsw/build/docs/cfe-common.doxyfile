# Strip mission from path
STRIP_FROM_PATH       += /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw

# CFE mnemonic mappings
@INCLUDE = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/cfe/docs/src/mnem_maps/cfe_es_cmd_mnem_map
@INCLUDE = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/cfe/docs/src/mnem_maps/cfe_es_tlm_mnem_map
@INCLUDE = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/cfe/docs/src/mnem_maps/cfe_tbl_cmd_mnem_map
@INCLUDE = /mnt/extras/SSD/NOS3_RBT/nos3_local_OISL/fsw/cfe/docs/src/mnem_maps/cfe_tbl_tlm_mnem_map
